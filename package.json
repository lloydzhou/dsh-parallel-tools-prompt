{
  "name": "dsh-parallel-tools-prompt",
  "version": "0.2.1-rc.1",
  "description": "Plan ready tool-call batches to reduce model round trips in DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloydzhou/dsh-parallel-tools-prompt.git"
  },
  "homepage": "https://github.com/lloydzhou/dsh-parallel-tools-prompt#readme",
  "bugs": {
    "url": "https://github.com/lloydzhou/dsh-parallel-tools-prompt/issues"
  },
  "publishConfig": { "access": "public", "tag": "next" },
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "scripts/analyze-session.mjs"],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.3",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@types/node": "^24.0.0",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
